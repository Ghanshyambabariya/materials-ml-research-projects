{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Materials dataset metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["identifier", "title", "description", "creator", "license", "created", "version", "keywords", "provenance", "units"],
  "properties": {
    "identifier": {"type": "string", "format": "uuid"},
    "title": {"type": "string", "minLength": 3},
    "description": {"type": "string", "minLength": 20},
    "creator": {"type": "string", "minLength": 2},
    "license": {"type": "string", "enum": ["CC0-1.0", "CC-BY-4.0"]},
    "created": {"type": "string", "format": "date"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "keywords": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["kind", "method"], "properties": {"kind": {"enum": ["synthetic", "experimental"]}, "method": {"type": "string", "minLength": 10}}},
    "units": {"type": "object", "additionalProperties": false, "required": ["temperature_k", "density_g_cm3", "porosity_fraction", "strength_mpa"], "properties": {"temperature_k": {"const": "K"}, "density_g_cm3": {"const": "g/cm^3"}, "porosity_fraction": {"const": "1"}, "strength_mpa": {"const": "MPa"}}}
  }
}
